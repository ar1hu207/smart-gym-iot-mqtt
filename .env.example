# Copie para .env e ajuste. Todas as chaves são opcionais.

# ── Broker MQTT ──────────────────────────────────────────────
# Público da HiveMQ (padrão). Para o broker da aula ou Mosquitto local, troque aqui.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
# MQTT_USUARIO=
# MQTT_SENHA=
# MQTT_TLS=0

# Prefixo dos tópicos. Em broker público, use um prefixo único do grupo.
TOPICO_RAIZ=fiap/3espz/smartgym

# ── Estação (publisher) ─────────────────────────────────────
ESTACAO_ID=estacao-01
ESTACAO_NOME=Estação 01
EXERCICIO=Rosca direta
# SERIAL_PORTA=COM5          # vazio = detecção automática
# SERIAL_BAUD=115200
# CAMERA_INDICE=0
# TEMPO_FIM_SERIE_S=6        # segundos sem repetição = fim da série
# TEMPO_INATIVIDADE_S=180    # logout automático
# ANGULO_EXTENSAO=150
# ANGULO_INICIO_MOV=130
# ANGULO_FLEXAO=55

# ── Dashboard (subscriber) ──────────────────────────────────
# DASHBOARD_PORTA=5000
